{
  "name": "element-like",
  "version": "0.1.0",
  "description": "A Vue 3 components library with Element-style UI components",
  "type": "module",
  "keywords": [
    "vue3",
    "components",
    "library",
    "element-like"
  ],
  "license": "MIT",
  "homepage": "https://github.com/bingquan040601/element-like",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bingquan040601/element-like.git"
  },
  "files": [
    "dist",
    "docs"
  ],
  "main": "./dist/umd/element-like.umd.cjs",
  "module": "./dist/es/element-like.js",
  "types": "./dist/es/bundle.d.ts",
  "exports": {
    ".": {
      "types": "./dist/es/bundle.d.ts",
      "import": "./dist/es/element-like.js",
      "require": "./dist/umd/element-like.umd.cjs"
    },
    "./style.css": {
      "import": "./dist/style.css",
      "require": "./dist/umd/style.css"
    }
  },
  "sideEffects": [
    "**/*.css",
    "**/*.scss"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:lib": "pnpm build-es && pnpm build-umd && pnpm move-style && pnpm copy-types",
    "build-es": "vite build --config vite.es.config.ts",
    "build-umd": "vite build --config vite.umd.config.ts",
    "move-style": "node scripts/move-style.mjs",
    "copy-types": "node scripts/copy-types.mjs",
    "build:site": "run-p type-check \"build-site-only {@}\" --",
    "build-site-only": "vite build --base=/element-like/",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s \"lint:*\"",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^7.3.1",
    "@fortawesome/free-solid-svg-icons": "^7.3.1",
    "@fortawesome/vue-fontawesome": "^3.3.3"
  },
  "peerDependencies": {
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "^24.0.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.13.4",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.82.0",
    "eslint-plugin-vue": "~10.11.0",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "~1.82.0",
    "prettier": "3.9.6",
    "sass-embedded": "^1.105.1",
    "typescript": "~6.0.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^4.1.11",
    "vue": "^3.5.42",
    "vue-eslint-parser": "^10.4.1",
    "vue-router": "^5.3.1",
    "vue-tsc": "^3.3.11"
  },
  "engines": {
    "node": "^22.18.0 || >=24.12.0"
  }
}
